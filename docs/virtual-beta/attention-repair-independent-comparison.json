    {
      "claim": "Exclusive flat and unframed hierarchy alone did not produce observed inspection in phase1; all12repaired runs stopped at the first current-view decision.",
      "scope": "Phase1fixedargmax24runs; no cognition claim."
    },
    {
      "claim": "Task framing produced notification-page gaze reselection in3/3foveated runs, making the stop control newly eligible after an actual look before it was clicked.",
      "scope": "Phase2foveatedframed only; newframed vsunframed changes only explicit taskFrame with sameactorassets/questions/candidates."
    },
    {
      "claim": "Foveated framed reached the objective in3/3runs; subjective completion was2/3, with one run API-censored after performing the objective action.",
      "scope": "Outcome types kept separate; no censoredrun relabelled complete."
    },
    {
      "claim": "Crop framed remained STUCK with no look or UI action in3/3runs.",
      "scope": "No general improvement claim across vision modes."
    }
